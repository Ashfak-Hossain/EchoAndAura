# Pin exact versions on every `pnpm add` — CLAUDE.md: "Pin dependency versions
# exactly. No ^ ranges." This keeps package.json and the lockfile deterministic.
save-exact=true

# The bleeding-edge stack (Next 16 / React 19 / Tailwind 4) has unavoidable peer
# mismatches from packages not yet updated for React 19. Don't hard-fail installs
# on peers (see docs/DECISIONS.md ADR-003). Warnings still print.
strict-peer-dependencies=false