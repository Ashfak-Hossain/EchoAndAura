# Editor defaults, matching Prettier (.prettierrc) so the two never disagree.
# Line endings are also enforced by git (.gitattributes).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a line break in Markdown.
[*.{md,mdx}]
trim_trailing_whitespace = false

# Generated by drizzle-kit, never hand-edited (CLAUDE.md): some files use
# tabs and none ends in a newline, so an editor saving one must not change it.
[drizzle/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
