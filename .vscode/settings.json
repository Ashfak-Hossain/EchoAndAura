{
  // CloudFormation's short-form functions (ops/aws/*.yaml). Without these the
  // YAML extension marks every !Sub / !GetAtt / !Ref as "Unresolved tag".
  "yaml.customTags": [
    "!And sequence",
    "!Base64 scalar",
    "!Base64 mapping",
    "!Cidr scalar",
    "!Cidr sequence",
    "!Condition scalar",
    "!Equals sequence",
    "!FindInMap sequence",
    "!GetAtt scalar",
    "!GetAtt sequence",
    "!GetAZs scalar",
    "!If sequence",
    "!ImportValue scalar",
    "!ImportValue mapping",
    "!Join sequence",
    "!Not sequence",
    "!Or sequence",
    "!Ref scalar",
    "!Select sequence",
    "!Split sequence",
    "!Sub scalar",
    "!Sub sequence"
  ]
}
