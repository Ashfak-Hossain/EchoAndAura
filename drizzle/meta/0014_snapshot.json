        "orders_bkash_trx_id_normalised": {
          "name": "orders_bkash_trx_id_normalised",
          "value": "\"orders\".\"bkash_trx_id\" IS NULL OR \"orders\".\"bkash_trx_id\" = upper(btrim(\"orders\".\"bkash_trx_id\"))"
        },
        "orders_totals_nonneg": {
          "name": "orders_totals_nonneg",
          "value": "\"orders\".\"subtotal_paisa\" >= 0 AND \"orders\".\"discount_paisa\" >= 0 AND \"orders\".\"total_paisa\" >= 0"
        },
        "orders_totals_consistent": {
          "name": "orders_totals_consistent",
          "value": "\"orders\".\"subtotal_paisa\" = \"orders\".\"unit_price_paisa\" * \"orders\".\"quantity\" AND \"orders\".\"discount_paisa\" <= \"orders\".\"subtotal_paisa\" AND \"orders\".\"total_paisa\" = \"orders\".\"subtotal_paisa\" - \"orders\".\"discount_paisa\""
        },
        "orders_complimentary_free": {
          "name": "orders_complimentary_free",
          "value": "\"orders\".\"complimentary_reason\" IS NULL OR (\"orders\".\"discount_paisa\" = \"orders\".\"subtotal_paisa\" AND \"orders\".\"bkash_trx_id\" IS NULL AND \"orders\".\"promo_code_id\" IS NULL)"
        }
      },
