# echoandaura — environment template.

# --- Postgres  ---
POSTGRES_USER=echoandaura
POSTGRES_DB=echoandaura
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgresql://echoandaura:local_password@localhost:5432/echoandaura
TEST_DATABASE_URL=postgresql://echoandaura:local_password@localhost:5432/echoandaura_test

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- better-auth (admin only). Generate: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage: MinIO locally, Cloudflare R2 in production (same S3 API)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=local_password
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=local_password
R2_BUCKET=echoandaura
R2_PUBLIC_URL=http://localhost:9000/echoandaura

# --- Manual bKash (no API) ---
BKASH_RECEIVE_NUMBER=01700000000

ORGANIZER_CONTACT_EMAIL=

# --- App ---
APP_TIMEZONE=Asia/Dhaka
SITE_URL=http://localhost:3000
APP_ENV=local
# FACEBOOK_PAGE_URL=https://www.facebook.com/  (optional)


# --- AWS ---
MAILER=ses
AWS_ACCOUNT_ID=...
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=AKIA...
AWS_SES_SECRET_ACCESS_KEY=...
EMAIL_FROM="echoandaura <tickets@echoandaura.com>"
EMAIL_REPLY_TO=hello@echoandaura.com
ORGANIZER_CONTACT_EMAIL=hello@echoandaura.com
ORGANIZER_PHONE="01712 345678"