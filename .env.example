# echoandaura — environment template. Copy to .env and fill real values.
# .env is git-ignored; this template is committed.

# --- Postgres (docker compose reads these) ---
POSTGRES_USER=echoandaura
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=echoandaura
DATABASE_URL=postgresql://echoandaura:local_dev_only_change_me@localhost:5432/echoandaura
# TEST_DATABASE_URL=postgresql://echoandaura:local_dev_only_change_me@localhost:5432/echoandaura_test

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- better-auth (admin only). Generate: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000

# --- Resend (needs a verified domain; used from Phase 4) ---
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=echoandaura <tickets@example.com>

# --- Cloudflare R2 (used from Phase 1 image upload) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=echoandaura
R2_PUBLIC_URL=

# --- Manual bKash (no API) ---
BKASH_RECEIVE_NUMBER=01700000000

# --- App ---
APP_TIMEZONE=Asia/Dhaka
