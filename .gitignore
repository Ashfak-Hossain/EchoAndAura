# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/
/docs-site/node_modules/
/docs-site/.next/
/docs-site/.source/
/docs-site/out/
/docs-site/test-results/
/docs-site/playwright-report/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; the example template is)
.env*
!.env.example

# vercel
.vercel

# playwright
/test-results/
/playwright-report/
/blob-report/

# personal working notes — roadmap, session log, scaffold, tooling guide.
# Kept on disk (read by the /prime and /wrap commands) 
/notes/

# typescript
*.tsbuildinfo
next-env.d.ts
tmp/
dist/

# ADR-035: the /door service worker, built by `pnpm sw:build`
/public/door/

# Wrangler (gate relay, ADR-058): local Durable Object state and builds
.wrangler/
.dev.vars*

# Terraform (ADR-062): state lives in S3, never here; providers download per machine.
# .terraform.lock.hcl IS committed (pins provider checksums).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Ansible (ADR-063): the pinned tools and collections are installed per
# machine; the lab inventory holds a throwaway VM's address.
ops/ansible/.venv/
ops/ansible/collections/
ops/ansible/inventory/lab.yml
