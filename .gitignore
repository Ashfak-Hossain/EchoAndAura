# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets never committed; the example template is)
.env*
!.env.example

# vercel
.vercel

# playwright
/test-results/
/playwright-report/
/blob-report/

# personal working notes — roadmap, session log, scaffold, tooling guide.
# Kept on disk (read by the /prime and /wrap commands) 
/notes/

# typescript
*.tsbuildinfo
next-env.d.ts
tmp/
dist/

# ADR-035: the /door service worker, built by `pnpm sw:build`
/public/door/
