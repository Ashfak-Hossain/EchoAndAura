{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(python3 *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(sleep *)",
      "Bash(curl *)",
      "Bash(dig *)",
      "Bash(lsof *)",
      "Bash(pkill *)",
      "Bash(aws sts *)",
      "Bash(aws iam list-*)",
      "Bash(aws iam get-*)",
      "Bash(aws sesv2 get-*)",
      "Bash(aws sesv2 list-*)",
      "Bash(aws budgets describe-*)",
      "Bash(git fetch*)",
      "Bash(git tag -l*)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git describe*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh release view*)",
      "Bash(gh release list*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Edit(drizzle/**)",
      "Write(drizzle/**)",
      "Edit(src/components/ui/**)",
      "Write(src/components/ui/**)",
      "Bash(cat .env*)",
      "Bash(cat * .env*)",
      "Bash(grep * .env*)",
      "Bash(sed * .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(psql *)",
      "Bash(aws iam create-*)",
      "Bash(aws iam delete-*)",
      "Bash(aws iam put-*)",
      "Bash(git tag -a*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git tag -s*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release delete*)",
      "Bash(gh release upload*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh workflow run*)",
      "Bash(terraform * apply*)",
      "Bash(terraform * destroy*)",
      "Bash(pnpm tf:* apply*)",
      "Bash(pnpm tf:* destroy*)",
      "Bash(pnpm ansible apply*)",
      "Bash(pnpm relay:deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(docker push*)",
      "Bash(docker buildx imagetools create*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/git-tidy.sh --hook",
            "timeout": 30,
            "statusMessage": "Tidying git"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-size.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/statusline.sh",
    "padding": 0
  }
}
