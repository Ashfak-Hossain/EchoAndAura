{
  "name": "echoandaura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "dotenv -e .env -- vitest run --project integration",
    "test:integration:db": "dotenv -e .env -- vitest run --project integration tests/integration/inventory",
    "test:e2e": "playwright test",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "admin:create": "dotenv -e .env -- tsx scripts/create-admin.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@base-ui/react": "1.8.0",
    "@react-email/components": "1.0.12",
    "@react-pdf/renderer": "4.9.0",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.4",
    "bullmq": "6.3.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "lucide-react": "1.45.0",
    "nanoid": "6.0.1",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.5",
    "resend": "6.28.0",
    "sanitize-html": "2.17.7",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "5.0.0",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
