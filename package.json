{
  "name": "echoandaura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sw:build && NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "sw:build": "esbuild src/app/door/offline/sw.ts --bundle --format=iife --target=es2020 --minify --outfile=public/door/sw.js --log-level=warning",
    "worker:build": "esbuild src/worker.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=dist/worker.mjs --log-level=warning",
    "ops:build": "esbuild scripts/migrate.ts scripts/create-admin.ts scripts/promote-admin.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/ops --out-extension:.js=.mjs --log-level=warning",
    "worker": "pnpm worker:build && dotenv -e .env -- node dist/worker.mjs",
    "jobs:expire-holds": "dotenv -e .env -- tsx scripts/expire-holds.ts",
    "email:render": "dotenv -e .env -- tsx scripts/render-emails.ts",
    "email:test": "dotenv -e .env -- tsx scripts/send-test-email.ts",
    "infra:check": "dotenv -e .env -- tsx scripts/infra-check.ts",
    "typecheck": "NEXT_DIST_DIR=.next-build next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "dotenv -e .env -- vitest run --project integration",
    "test:integration:db": "dotenv -e .env -- vitest run --project integration tests/integration/inventory tests/integration/door tests/integration/sponsors",
    "test:e2e": "dotenv -e .env -- playwright test",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "db:seed": "dotenv -e .env -v LOG_LEVEL=warn -- tsx scripts/seed/run.ts",
    "admin:create": "dotenv -e .env -- tsx scripts/create-admin.ts",
    "admin:promote": "dotenv -e .env -- tsx scripts/promote-admin.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-sesv2": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@base-ui/react": "1.8.0",
    "@react-email/components": "1.0.12",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "barcode-detector": "3.2.2",
    "better-auth": "1.7.4",
    "bullmq": "6.3.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "lucide-react": "1.45.0",
    "nanoid": "6.0.1",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.5",
    "recharts": "3.8.0",
    "sanitize-html": "2.17.7",
    "shadcn": "4.21.0",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "5.0.0",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
